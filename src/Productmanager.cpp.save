
#include "ReportTemplate.hpp"
#include "ProductManager.hpp"
#include "Product.hpp"

#include <iostream>
#include <map>
#include <string>

ReportTemplate::ReportTemplate(ProductManager& pm)
    : productManager(pm) {}

void ReportTemplate::generate(ReportType type,
                              const std::string& username,
                              int threshold) {

    std::cout << "\n================ REPORT ================\n";
    std::cout << "Generated by: " << username << "\n\n";

    const auto& products = productManager.getAllProducts();

    switch (type) {

        case ReportType::FULL_INVENTORY:
            std::cout << "FULL INVENTORY REPORT\n\n";
            Product::displayHeader();
            for (const auto& p : products) p.displayRow();
            break;

        case ReportType::SUMMARY:
            std::cout << "SUMMARY REPORT\n\n";
            std::cout << "Total Products: " << products.size() << "\n";
            break;

        case ReportType::LOW_STOCK:
            std::cout << "LOW STOCK REPORT (<= " << threshold << ")\n\n";
            Product::displayHeader();
            for (const auto& p : products)
                if (p.getQuantity() <= threshold)
                    p.displayRow();
            break;

        case ReportType::CATEGORY_BREAKDOWN: {
            std::cout << "CATEGORY BREAKDOWN REPORT\n\n";

            std::map<std::string, int> counts;

            for (const auto& p : products)
                counts[p.getCategory()]++;

            for (const auto& [cat, count] : counts)
                std::cout << cat << " : " << count << "\n";

            break;
        }
    }

    std::cout << "\n========================================\n";
}

void ReportTemplate::preview(ReportType type, int threshold) {
    generate(type, "PREVIEW", threshold);
}
